{
  "id": "travel",
  "name": "Planner",
  "version": "0.14.2",
  "icon": "suitcase-rolling",
  "color": "teal",
  "description": "Plan together: a day-by-day itinerary that draws in the events, tasks and polls your {space} already has.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 460,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the trip",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Plan the trip: add, change and move things on it",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "lookups": [
    "flight"
  ],
  "events": {
    "subscribes": [
      "*"
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "addStop",
        "label": "Add it to the trip",
        "input": {
          "title": "string",
          "date": "date?",
          "notes": "text?",
          "ref": "ref?"
        }
      },
      {
        "name": "addToDay",
        "label": "Put it on the trip's itinerary",
        "input": {
          "object": "ref",
          "date": "date?"
        }
      },
      {
        "name": "acceptSuggestion",
        "label": "Add it to the trip, properly typed",
        "input": {
          "title": "string",
          "kind": "string?",
          "content": "text?",
          "place": "string?",
          "date": "date?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["flight", "train", "bus", "ferry", "car"], "as": "{kind}" },
          { "kinds": ["hotel"], "as": "a stay" },
          { "kinds": ["restaurant", "cafe", "bar", "sight", "museum", "tour", "show", "event"], "as": "{kind}" },
          { "kinds": ["note"], "as": "a note" }
        ]
      },
      {
        "name": "addFromText",
        "label": "Add to the trip from text",
        "local": true,
        "input": {
          "text": "string"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "commands": [
    { "name": "p", "label": "Add to the trip", "action": "addFromText", "hint": "something on the trip" }
  ],
  "storage": {
    "renamed": [
      { "from": "item:", "to": "plan:" }
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "trip",
        "name": "Trip",
        "open": true,
        "backlinks": true,
        "key": "trip:{id}",
        "summary": {
          "title": "title",
          "subtitle": "destination",
          "when": "start",
          "end": "end"
        }
      },
      {
        "kind": "plan",
        "name": "{name}",
        "open": true,
        "backlinks": true,
        "key": "plan:{id}",
        "holds": { "field": "ref", "onDelete": "remove", "follow": { "title": "title", "day": "date", "pin": "pinned" } },
        "dated": { "title": "title", "day": "date", "time": "time", "endDay": "checkOut" },
        "mirror": "out",
        "summary": {
          "title": "title",
          "subtitle": "place",
          "when": "date",
          "done": "done"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "settings": [
    {
      "key": "markers",
      "label": "Markers",
      "type": "list",
      "scope": "environment",
      "maxLength": 30,
      "fixed": [
        "planning-start",
        "planning-end",
        "trip-start",
        "trip-end"
      ],
      "help": "The markers a plan draws: the four automatic ones (their label, icon and colour can change), and the ones people add -- on a day at a time (a time block, such as free time), on a whole day (a tag in its header, such as a travel day), or on the line between days.",
      "default": [
        {
          "id": "planning-start",
          "label": "Planning starts",
          "icon": "flag",
          "color": "#3b82f6"
        },
        {
          "id": "planning-end",
          "label": "Planning ends",
          "icon": "flag-checkered",
          "color": "#8b5cf6"
        },
        {
          "id": "trip-start",
          "label": "Trip starts",
          "icon": "plane-departure",
          "color": "#22c55e"
        },
        {
          "id": "trip-end",
          "label": "Trip ends",
          "icon": "plane-arrival",
          "color": "#f97316"
        },
        {
          "id": "free-time",
          "label": "Free time",
          "icon": "face-smile",
          "color": "#14b8a6"
        },
        {
          "id": "rest",
          "label": "Rest",
          "icon": "moon",
          "color": "#6366f1"
        },
        {
          "id": "buffer",
          "label": "Buffer",
          "icon": "hourglass-half",
          "color": "#a3a3a3"
        },
        {
          "id": "meet-up",
          "label": "Meet-up",
          "icon": "users",
          "color": "#ec4899"
        },
        {
          "id": "leave-by",
          "label": "Leave by",
          "icon": "clock",
          "color": "#eab308"
        },
        {
          "id": "travel-day",
          "label": "Travel day",
          "icon": "suitcase-rolling",
          "color": "#0ea5e9"
        },
        {
          "id": "free-day",
          "label": "Free day",
          "icon": "sun",
          "color": "#f59e0b"
        }
      ]
    },
    {
      "key": "suggestFlights",
      "label": "Suggest flights from earlier trips",
      "type": "boolean",
      "scope": "environment",
      "default": true,
      "help": "Fill a flight from the same flight number saved before on this server. Flights saved here also help others; turn this off to keep them out."
    }
  ]
}
