{
  "id": "calendar",
  "name": "Calendar",
  "version": "1.22.1",
  "icon": "calendar-days",
  "color": "red",
  "description": "Sessions and events for the whole {environment} and for each {space}, with reminders.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "destination": [
      { "id": "calendar", "part": "main", "entry": "page.html" },
      { "id": "calendar", "part": "panel", "entry": "page.html", "label": "Agenda", "order": 10 }
    ],
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 400,
      "height": 580,
      "mode": [
        "dock",
        "float"
      ],
      "lobby": true
    },
    "widget": {
      "entry": "widget.html",
      "title": "Coming up",
      "size": "tall",
      "order": 10
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the calendar",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add and change events",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "settings": [
    {
      "key": "defaultView",
      "label": "Open on",
      "type": "choice",
      "scope": "person",
      "default": "month",
      "help": "The view the Calendar shows when you open it.",
      "options": [
        {
          "value": "month",
          "label": "Month"
        },
        {
          "value": "week",
          "label": "Week"
        },
        {
          "value": "day",
          "label": "Day"
        },
        {
          "value": "list",
          "label": "Agenda"
        }
      ]
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "hooks": {
    "schedule": true,
    "notify": true,
    "external": true
  },
  "events": {
    "publishes": [
      {
        "name": "ended",
        "kind": "event",
        "label": "An event has passed",
        "data": {
          "summary": "string"
        }
      }
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "createEvent",
        "label": "Add it to the calendar",
        "input": {
          "title": "string",
          "date": "date",
          "ref": "ref?"
        }
      },
      {
        "name": "addEvent",
        "label": "Add an event",
        "local": true,
        "input": {
          "text": "string"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "commands": [
    { "name": "c", "label": "Add an event", "action": "addEvent", "hint": "the event" }
  ],
  "refs": {
    "produces": [
      {
        "kind": "event",
        "name": "Event",
        "open": true,
        "backlinks": true,
        "key": "event:{id}",
        "summary": {
          "title": "title",
          "subtitle": "desc",
          "when": "start",
          "end": "end",
          "allDay": "allDay"
        },
        "dated": { "title": "title", "start": "start", "end": "end", "allDay": "allDay", "repeat": "repeat" },
        "feed": true,
        "mirror": "in",
        "create": { "id": "{id}", "desc": "", "remind": null, "repeat": null, "by": "{by}" }
      }
    ],
    "consumes": [
      "*"
    ]
  }
}
